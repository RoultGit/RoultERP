# Base de datos. En Supabase, use la cadena del "Connection pooling" en modo
# transacción para el runtime serverless, y la directa para las migraciones.
DATABASE_URL=postgres://localhost/roulterp_dev

# Clave maestra de cifrado: 32 bytes en base64.
# Genérela con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA la comparta ni la suba al repositorio. Si se pierde, los certificados
# digitales y los secretos TOTP guardados dejan de poder abrirse.
ROULTERP_KEK=
ROULTERP_KEK_ID=env-1

# Secreto con el que el programador de tareas llama a /api/cola para vaciar la
# cola de envío a SUNAT. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si se deja vacío, la cola sólo se vacía cuando alguien pulsa el botón.
ROULTERP_COLA_SECRETO=
